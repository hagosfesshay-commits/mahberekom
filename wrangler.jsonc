{
  "name": "mahberekom",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-19",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "OFFICE", "class_name": "Office" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Office"] }]
}
